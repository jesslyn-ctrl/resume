---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, stack, visibility, period } = project.data;
---

<article class="card">
  <p class="meta">
    <span>{period}</span>
    {visibility === 'limited' && <span class="limited">Limited detail</span>}
  </p>
  <h3><a href={url(`/projects/${project.id}/`)}>{title}</a></h3>
  <p class="summary">{summary}</p>
  <ul class="tag-row">
    {stack.map((tag) => <li class="tag">{tag}</li>)}
  </ul>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 22px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .card:focus-within {
    border-color: var(--accent);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 8px;
    font-size: 0.8rem;
    color: var(--text-soft);
  }
  .limited {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0 8px;
    white-space: nowrap;
  }
  h3 {
    margin: 0 0 8px;
    font-size: 1.08rem;
  }
  h3 a {
    color: var(--text);
  }
  h3 a:hover {
    text-decoration: none;
  }
  /* Make the whole card clickable through its title link. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .summary {
    margin: 0 0 18px;
    font-size: 0.94rem;
    color: var(--text-soft);
  }
  .tag-row {
    margin-top: auto;
  }
</style>
