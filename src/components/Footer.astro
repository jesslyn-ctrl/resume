---
import { profile, contactLinks } from '../data/profile';
---

<footer id="contact" class="site-footer">
  <div class="wrap">
    <p class="cta">{profile.cta}</p>
    <ul class="links">
      {
        contactLinks.map((link) => (
          <li>
            <a href={link.href} {...link.external ? { target: '_blank', rel: 'noopener' } : {}}>
              {link.label}
              {link.external && <span aria-hidden="true"> ↗</span>}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="note">© {new Date().getFullYear()} {profile.name}. Built with Astro, deployed on GitHub Pages.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 64px 0 72px;
    text-align: center;
  }
  .cta {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 16px;
    text-wrap: balance;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    color: var(--text);
  }
  .links a:hover {
    color: var(--accent);
  }
  .note {
    color: var(--text-soft);
    font-size: 0.85rem;
    margin: 40px 0 0;
  }
</style>
