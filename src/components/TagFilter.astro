---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="filter" data-tag-filter role="group" aria-label="Filter projects by technology" hidden>
  <button type="button" data-tag="" aria-pressed="true">All</button>
  {tags.map((tag) => <button type="button" data-tag={tag} aria-pressed="false">{tag}</button>)}
</div>
<p class="empty" data-filter-status role="status"></p>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }
  .filter[hidden] {
    display: none;
  }
  button {
    font: inherit;
    font-size: 0.85rem;
    padding: 5px 13px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
  }
  button:hover {
    color: var(--text);
    border-color: var(--text-soft);
  }
  button[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  .empty {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    margin: 0;
  }
</style>
